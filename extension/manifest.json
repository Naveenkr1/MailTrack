{
  "manifest_version": 3,
  "name": "Mail Track — Email Tracking for Gmail",
  "version": "1.0.6",
  "description": "Real-time email open & click tracking for Gmail with double checkmarks (Mailsuite Parity).",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mail Track Status"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://mailtrack.in/*",
        "https://www.mailtrack.in/*",
        "https://mail-track-pink.vercel.app/*",
        "https://*.vercel.app/*",
        "http://localhost:4000/*"
      ],
      "js": ["auth-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://mailtrack.in/*",
      "https://www.mailtrack.in/*",
      "https://mail-track-pink.vercel.app/*",
      "https://*.vercel.app/*",
      "http://localhost:4000/*"
    ]
  },
  "permissions": [
    "storage",
    "notifications",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "tabs",
    "cookies"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://mail.google.com/*"]
    }
  ]
}
