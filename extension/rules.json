[
  {
    "id": 1,
    "priority": 1,
    "action": { "type": "block" },
    "condition": {
      "urlFilter": "/trace/mail/",
      "resourceTypes": ["image", "xmlhttprequest", "other", "sub_frame"]
    }
  },
  {
    "id": 2,
    "priority": 2,
    "action": { "type": "block" },
    "condition": {
      "regexFilter": ".*googleusercontent\\.com.*(?:trace.*mail|mail.*trace).*",
      "resourceTypes": ["image"]
    }
  },
  {
    "id": 3,
    "priority": 3,
    "action": {
      "type": "redirect",
      "redirect": { "regexSubstitution": "\\1" }
    },
    "condition": {
      "regexFilter": ".*(?:googleusercontent\\.com|proxy).*#(.*\\/trace\\/mail\\/.*)",
      "resourceTypes": ["image"]
    }
  },
  {
    "id": 4,
    "priority": 1,
    "action": {
      "type": "modifyHeaders",
      "requestHeaders": [
        { "header": "X-MailTrack-Sender", "operation": "set", "value": "1" }
      ]
    },
    "condition": {
      "urlFilter": "/trace/link/",
      "resourceTypes": ["main_frame", "sub_frame", "xmlhttprequest"]
    }
  }
]
