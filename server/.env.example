PORT=4000
NODE_ENV=production

# Cryptographic secrets (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# Google OAuth 2.0 Credentials (obtain from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Public Base URL (used for OAuth callbacks, tracking pixels, and wss:// config)
# Local dev: http://localhost:4000
# Oracle Cloud / VPS: https://mailtrack.in
BASE_URL=http://localhost:4000

# Oracle Cloud / VPS Reverse Proxy vs Cloudflare Tunnel
# - Set DISABLE_TUNNEL=true when serving behind Caddy/Nginx on Oracle Cloud (recommended)
# - Or leave empty with a public BASE_URL to automatically skip quick trycloudflare tunnels
DISABLE_TUNNEL=false
ENABLE_QUICK_TUNNEL=false

# Optional: Cloudflare Named Tunnel (zero open ports needed on Oracle Cloud)
CUSTOM_DOMAIN=
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: Pin local dev host public IP for self-open suppression (leave empty on cloud VMs)
HOST_SENDER_IP=

# Turso Free Cloud Database (recommended - keeps existing production data; omit to use local SQLite in server/data/mailtrack.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Set to false in production to disable mock/developer login
ALLOW_DEV_LOGIN=false


